# Copy this file to .env for LOCAL development only. Never commit the real
# .env file to git — add it to .gitignore if it isn't already.
#
# On Railway, you don't use this file at all — instead, set each of these
# as an environment variable in the Railway dashboard (Project → Variables).

# Generate a fresh one — do NOT reuse the key that was in settings.py before.
# You can generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-this-with-a-freshly-generated-secret-key

DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

# Leave blank locally. On Railway, set to your actual domain, e.g.:
# CSRF_TRUSTED_ORIGINS=https://yourapp.up.railway.app
CSRF_TRUSTED_ORIGINS=

# Leave unset locally to keep using sqlite3. On Railway this gets set
# automatically once you add the Postgres plugin.
# DATABASE_URL=postgres://user:password@host:port/dbname

# Use the NEW app password you generate after revoking the old one.
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-new-gmail-app-password

# From your Cloudinary dashboard (cloudinary.com/console) — Account Details
# section shows all three of these directly.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
